# Copy to .env and fill in. Nothing here is required to run the app locally —
# without Stripe keys it runs in trial-only mode and billing is disabled.

PORT=3000
NODE_ENV=development

# Where the SQLite file lives. On a host with a mounted volume, point this
# inside the volume or you lose the data on every redeploy.
DATABASE_PATH=./data/haulmath.db

# --- Stripe (needed only when you want to charge for it) -------------------
# Secret key: Stripe dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=

# Price ID of a recurring product: Stripe dashboard -> Products -> your price.
# Starts with "price_", not "prod_".
STRIPE_PRICE_ID=

# Webhook signing secret: Stripe dashboard -> Developers -> Webhooks -> your
# endpoint (https://your-domain/webhook). Starts with "whsec_".
STRIPE_WEBHOOK_SECRET=

# Shown on the billing page. Keep it matching the real price.
PRICE_LABEL=$29/month
