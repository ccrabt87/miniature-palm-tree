{
  "name": "haulmath",
  "version": "1.0.0",
  "private": true,
  "description": "Load profitability, load book, invoicing and IFTA tracking for independent truckers and small carriers.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:client && tsx watch src/server.ts",
    "build": "npm run build:client && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "tsc -p tsconfig.client.json",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
